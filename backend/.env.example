# ALPACART API — FastAPI
APP_ENV=development
API_PREFIX=/api/v1
PORT=8000
CORS_ORIGINS=http://localhost:3200,http://localhost:3300

# PostgreSQL 18
DB_HOST=localhost
DB_PORT=5448
DB_USER=alpacart
DB_PASSWORD=alpacart
DB_NAME=alpacart_new

# Redis (opcional — fail-open)
REDIS_HOST=localhost
REDIS_PORT=6389

# Auth
JWT_SECRET=alpacart-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago — Checkout API (pago embebido)
#
# Panel de Mercado Pago -> Tus integraciones -> tu aplicacion -> Credenciales.
#   TEST-…      sandbox        APP_USR-…   produccion
# La clave publica viaja al navegador (la sirve GET /payments/config); el
# access token es solo del servidor: permite cobrar en nombre de la cuenta.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Webhooks -> Configurar notificaciones. La clave secreta del webhook NO es el
# access token, y modo prueba y modo productivo tienen claves DISTINTAS: con la
# de prueba en produccion, todos los avisos se rechazan con 401.
MP_WEBHOOK_SECRET=
# Dominio publico con esquema y sin barra final. De aca sale la
# notification_url completa (https://DOMINIO/api/v1/payments/mercadopago/webhook),
# que es la que hay que pegar en el panel: con solo el dominio, Mercado Pago
# recibe el index.html de la SPA y ningun pago se concilia jamas.
# En desarrollo se deja vacia: MP rechaza los hosts locales.
PUBLIC_BASE_URL=
