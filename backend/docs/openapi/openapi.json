        "tags": ["Customers"],
        "summary": "Actualizar cantidad",
        "security": [{ "bearer": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Cantidad actualizada" } }
      },
      "delete": {
        "tags": ["Customers"],
        "summary": "Eliminar item del carrito",
        "security": [{ "bearer": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
