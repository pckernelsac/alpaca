# ALPACART API — FastAPI
APP_ENV=development
API_PREFIX=/api/v1
PORT=8000
CORS_ORIGINS=http://localhost:3200,http://localhost:3300

# PostgreSQL 18
DB_HOST=localhost
DB_PORT=5448
DB_USER=alpacart
DB_PASSWORD=alpacart
DB_NAME=alpacart_new

# Redis (opcional — fail-open)
REDIS_HOST=localhost
REDIS_PORT=6389

# Auth
JWT_SECRET=alpacart-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
